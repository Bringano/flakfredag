# Lokal utveckling (utan Docker Compose) — peka mot din lokala Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/beerapp
PORT=3000

# Delat lösenordsskydd. APP_USERNAME måste vara "flakfredag" (hårdkodat i
# client/src/auth.ts). Lämna båda tomma för att stänga av skyddet lokalt.
APP_USERNAME=flakfredag
APP_PASSWORD=bärka
